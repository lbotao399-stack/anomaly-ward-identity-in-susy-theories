  "new_step5_definitions": [
    {
      "consequence": "G^{AB}(p;theta1,theta2)=hbar*kappa^{AB}*delta^4(theta1-theta2)/p^2 and K*G=hbar*identity.",
      "definition": "Stay in the vector-frame residual-free canonical coordinate v and choose the background supersymmetric Fermi-Feynman slice with S0=(1/2) int v^A kappa_AB(-partial^2)v^B.",
      "id": "DEF-WW-PHYS-01"
    },
    {
      "consequence": "The coefficient Schwinger identity contains only insertion derivatives and the Euler insertion.",
      "definition": "Choose a constant coefficient density in this residual-free canonical chart. Measure divergence in (3D.34) is zero.",
      "id": "DEF-WW-PHYS-02"
    },
    {
      "consequence": "Loop tensor reduction returns hatdelta; four-dimensional D-algebra returns delta4.",
      "definition": "DRED: d=4-2*epsilon, delta4=hatdelta+brevedelta, tr(hatdelta)=d, tr(brevedelta)=2*epsilon; loop momenta are hatted and external p,q,w have no breve components.",
      "id": "DEF-WW-PHYS-03"
    },
    {
      "consequence": "The i from the barW vertex and -i from mathsf p multiply to +1.",
      "definition": "Fourier phase exp(+i p.x), mathsf p_a dot-a=-i sigma^m_a dot-a p_m, so {D_a,barD_dot-a}=2 mathsf p_a dot-a.",
      "id": "DEF-WW-PHYS-04"
    },
    {
      "consequence": "Every order-g^2 source vertex is generated by L1,L2,L3 and T0,T1,T2; no coefficient is adjusted to enforce a pole match.",
      "definition": "Use exactly S_J=int J_AB L^A(tau_w L)^B from the source proposal. No independent curvature improvement or local J counterterm is included in the bare insertion.",
      "id": "DEF-WW-PHYS-05"
    },
    {
      "consequence": "Topology reallocations may change nonlinear/quartic/collapsed labels, but cannot change an occurrence-row sum.",
      "definition": "Retain occurrence tags through all superspace integrations by parts. A cut row is the full product-rule descendant of one tagged parent row.",
      "id": "DEF-WW-PHYS-06"
    }
  ],
