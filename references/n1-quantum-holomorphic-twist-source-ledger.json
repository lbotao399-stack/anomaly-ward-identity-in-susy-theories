  "candidate_claims": [
    {
      "id": "QHT-REF-CLASSICAL-TWIST",
      "sources": ["ARXIV-2002-10517-V1-SOURCE", "ARXIV-2002-10517-V1-PDF"],
      "locator": "Section 10.1.1, Theorem 10.1, PDF page 70",
      "candidate_claim": "The classical holomorphic twist of 4d N=1 super Yang-Mills with matter is perturbatively equivalent to holomorphic BF with a beta-gamma matter sector; pure gauge is the zero-matter specialization.",
      "scope_limitation": "Classical perturbative BV equivalence only; no QME, counterterm, regulator, or path-integral theorem.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-RENORMALIZED-BV-QME",
      "sources": ["ARXIV-0706-1533-V3-SOURCE", "ARXIV-0706-1533-V3-PDF"],
      "locator": "Sections 1.5-1.8; Theorem B on PDF page 5; Theorem C and renormalized-QME definition on PDF pages 7-10",
      "candidate_claim": "A fixed renormalization scheme produces local counterterms and compatible effective actions; satisfying the renormalized QME is an additional condition on the effective family.",
      "scope_limitation": "Abstract elliptic BV framework; does not quantize this N=1 theory or prove twist compatibility.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-BV-PUSHFORWARD",
      "sources": ["ARXIV-1507-01221-V2-SOURCE", "ARXIV-1507-01221-V2-PDF"],
      "locator": "Section 2.2.2, Theorem 2.9 and equations (2.3)-(2.5), PDF page 12; Definition 2.11, Corollary 2.12, Theorem 2.15, PDF pages 13-15",
      "candidate_claim": "Finite-dimensional BV integration of half-densities along a Lagrangian fiber intertwines BV Laplacians; a Lagrangian homotopy changes the result by a BV-exact term.",
      "scope_limitation": "Finite-dimensional statement; infinite-dimensional use is perturbative/diagrammatic and requires separate renormalization.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-HOLOMORPHIC-COUNTERTERM",
      "sources": ["ARXIV-1809-02661-V2-SOURCE", "ARXIV-1809-02661-V2-PDF"],
      "locator": "Section 3, Theorem 3.4, PDF page 27",
      "candidate_claim": "A holomorphic theory on complex affine space admits a one-loop prequantization with no counterterms under the paper's hypotheses.",
      "scope_limitation": "Prequantization and counterterm finiteness do not imply the QME or anomaly cancellation.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-HOLOMORPHIC-QME-ANOMALY",
      "sources": ["ARXIV-1809-02661-V2-SOURCE", "ARXIV-1809-02661-V2-PDF"],
      "locator": "Definition 4.2 and Lemma 4.3 on PDF page 38; Proposition 4.4 and equation (24) on PDF page 39",
      "candidate_claim": "The one-loop QME obstruction is a local cohomology class and, for holomorphic theories on C^d, is represented by wheels with d+1 vertices.",
      "scope_limitation": "The relevant hBF wheel and color factor are not evaluated by the general theorem.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-N1-EXTENDED-ST-IDENTITY",
      "sources": ["ARXIV-HEP-TH-9507045-V2-SOURCE", "ARXIV-HEP-TH-9507045-V2-PDF"],
      "locator": "Section 3.2, equations (3.36)-(3.44), PDF pages 11-12; Section 5, PDF pages 14-15",
      "candidate_claim": "The local breaking of the generalized gauge-plus-supersymmetry Slavnov identity is a linearized-Slavnov coboundary plus the supersymmetric Adler-Bardeen cocycle.",
      "scope_limitation": "Minkowski Wess-Zumino-gauge 1PI algebraic renormalization; Euclidean BV/QME translation and the pure-adjoint cocycle calculation remain Project-side obligations.",
      "adoption_status": "NOT_ADOPTED_IN_REFERENCE_IMPORT"
    },
    {
      "id": "QHT-REF-R-Q-ANOMALY-SCHEME",
      "sources": ["ARXIV-1902-06715-V3-SOURCE", "ARXIV-1902-06715-V3-PDF", "ARXIV-2011-09978-V2-SOURCE", "ARXIV-2011-09978-V2-PDF"],
